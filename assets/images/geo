       <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 4rem; height: 4rem; border-radius: 50%; background: linear-gradient(135deg, var(--syd-maroon), #A01D47); display: flex; align-items: center; justify-content: center; box-shadow: inset 0 4px 12px rgba(0,0,0,.3);">
         <svg width="32" height="32" viewbox="0 0 32 32" fill="rgba(255,255,255,.92)"><polygon points="16,2 28,30 4,30" /> <rect x="14" y="8" width="4" height="18" fill="var(--syd-maroon)" />
