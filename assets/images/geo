        </svg>
       </div></button> <!-- Expandable Content -->
      <div id="egypt-content" class="card-expand">
       <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem;"><!-- Key Discovery Box 1 -->
        <div class="content-box" style="padding: 1.25rem; border-radius: var(--radius-lg);">
         <div style="display: flex; align-items: flex-start; gap: 0.75rem;"><span style="font-size: 1.5rem;">📜</span>
