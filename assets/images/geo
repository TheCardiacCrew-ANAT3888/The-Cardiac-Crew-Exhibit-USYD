      if (titleEl) {
        titleEl.textContent = config.timeline_title || defaultConfig.timeline_title;
      }
      if (subtitleEl) {
        subtitleEl.textContent = config.timeline_subtitle || defaultConfig.timeline_subtitle;
      }
    }

