    </div>
   </header><!-- Timeline Container -->
   <main style="position: relative; max-width: 520px; margin: 0 auto; padding: 0 1rem 4rem;"><!-- Central Timeline Line -->
    <div class="timeline-line" style="position: absolute; left: 50%; transform: translateX(-50%); top: 0; bottom: 0; width: 3px; border-radius: 9999px; display: block;"></div><!-- EGYPT SECTION -->
    <section style="position: relative; margin-bottom: 4rem;"><!-- Era Marker -->
     <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
