         <svg width="32" height="32" viewbox="0 0 32 32" fill="rgba(255,255,255,.92)"><rect x="6" y="24" width="20" height="4" /> <rect x="8" y="8" width="3" height="16" /> <rect x="21" y="8" width="3" height="16" /> <rect x="14" y="8" width="4" height="16" /> <path d="M4 8 L16 2 L28 8" fill="none" stroke="rgba(255,255,255,.92)" stroke-width="2" />
         </svg>
