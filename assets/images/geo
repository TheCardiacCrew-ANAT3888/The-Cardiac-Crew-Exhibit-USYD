         <circle cx="57" cy="35" r="7" fill="var(--syd-gold)" opacity="0.3" class="pin-glow" />
        </g> <!-- Heart symbol in center --> <path d="M60 48 C54 42, 46 42, 46 50 C46 60, 60 70, 60 70 C60 70, 74 60, 74 50 C74 42, 66 42, 60 48" fill="#8A1538" opacity="0.7" />
       </svg><!-- Info tooltip -->
