     <h1 id="timeline-title" style="font-size: 2.5rem; font-weight: bold; margin-bottom: 0.75rem; letter-spacing: 0.05em; color: var(--syd-gold);">History of Heart Anatomy</h1>
     <p id="timeline-subtitle" style="font-size: 1.25rem; font-style: italic; color: rgba(242,169,0,.7); margin: 0;">Ancient Civilisations Timeline (3000 BCE – 500 CE)</p><!-- Time Period Indicator -->
     <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 1.5rem;">
      <div class="accent-divider" style="height: 1px; width: 4rem;"></div><span style="color: var(--syd-gold); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;">Egypt • Greece • England</span>
      <div class="accent-divider" style="height: 1px; width: 4rem;"></div>
